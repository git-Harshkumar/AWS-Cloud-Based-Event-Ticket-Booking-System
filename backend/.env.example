# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Instance Identification (set differently for each EC2 instance)
INSTANCE_ID=backend-instance-1

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/event_booking?schema=public

# AWS Configuration (for production deployment)
AWS_REGION=us-east-1
S3_BUCKET=your-eventflow-bucket
CLOUDWATCH_LOG_GROUP=/aws/ec2/eventflow-backend
CLOUDWATCH_LOG_STREAM=backend-instance-1